---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgreementDemo from "../components/AgreementDemo";
import "agree-first/styles";
import "../styles/home.css";

const exampleCode = [
  'import { AgreeFirst } from "agree-first";',
  "",
  "const documents = [",
  '  { title: "Terms", url: "/terms", version: "1.4" },',
  '  { title: "Privacy", url: "/privacy", version: "2.0" },',
  "];",
  "",
  "<AgreeFirst",
  "  documents={documents}",
  "  onAccept={(payload) => payload && saveAgreement(payload)}",
  "/>",
].join("\n");
---

<BaseLayout
  title="agree-first"
  theme="dark"
  description="Versioned agreement flows for React. Track document acceptance and re-acceptance with your own UI, persistence, and optional review."
>
  <div class="home">
    <section class="home-hero">
      <div class="hero-pattern" aria-hidden="true"></div>
      <canvas class="hero-dots" aria-hidden="true"></canvas>
      <div class="home-wrap hero-content">
        <p class="hero-eyebrow"><span class="eyebrow-line" aria-hidden="true"></span> VERSIONED AGREEMENT FLOWS FOR REACT</p>
        <h1><span>Stop rebuilding</span> <span>agreement flows.</span></h1>
        <p class="hero-lead">A checkbox is easy. Tracking which documents and versions someone accepted—and when to ask again—is the part you should not have to rebuild.</p>
        <div class="hero-actions">
          <a class="home-button home-button-primary" href="/docs/installation/">Get started</a>
          <div class="install-command" role="group" aria-label="Install agree-first">
            <span class="install-prompt" aria-hidden="true">$</span>
            <code>npm install agree-first</code>
            <button type="button" data-copy-command aria-label="Copy install command" title="Copy install command">
              <svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
              <svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
              <span class="copy-feedback" data-copy-label aria-live="polite">Copy</span>
            </button>
          </div>
        </div>

        <div class="demo-intro"><span><i aria-hidden="true"></i> TRY BOTH REAL FLOWS</span><p>Change a version. Open a review. Inspect the payload.</p></div>
        <div class="hero-demo" id="demo"><AgreementDemo client:load /></div>
        <p class="hero-footnote">The demo starts with the simple agreement. Switch to optional review to try the package modal; sample records stay only in this page's memory.</p>
      </div>
    </section>

    <div class="proof-strip"><div class="home-wrap proof-inner"><div><strong>0</strong><span>runtime dependencies</span></div><div><strong>18 + 19</strong><span>React versions tested</span></div><div><strong>Optional</strong><span>CSS and review UI</span></div></div></div>

    <section class="story-section home-wrap" aria-labelledby="story-title">
      <div class="story-heading"><p class="section-kicker">01 / THE REPETITIVE PART</p><h2 id="story-title">A checkbox has <span>no memory.</span></h2><p>Real products need more than a Boolean. The last accepted document version matters, and the current version can change without the UI changing at all.</p></div>
      <div class="version-story" aria-label="Example of version-based re-acceptance">
        <div class="story-step"><span class="step-index">01</span><span class="step-content"><small>PREVIOUS RECORD</small><strong>Terms <em>v1.3</em></strong><span>Accepted on September 1</span></span><span class="step-mark" aria-hidden="true">✓</span></div>
        <div class="story-connector" aria-hidden="true"></div>
        <div class="story-step"><span class="step-index">02</span><span class="step-content"><small>CURRENT DOCUMENT</small><strong>Terms <em>v1.4</em></strong><span>The owner declared a new version</span></span><span class="step-mark update" aria-hidden="true">↗</span></div>
        <div class="story-connector" aria-hidden="true"></div>
        <div class="story-step story-outcome"><span class="step-index">03</span><span class="step-content"><small>AGREE-FIRST HANDLES</small><strong>Re-acceptance</strong><span>Request the current agreement again</span></span><span class="step-mark outcome" aria-hidden="true">↻</span></div>
      </div>
    </section>

    <section class="ways-section" aria-labelledby="ways-title"><div class="home-wrap">
      <div class="section-heading centered"><p class="section-kicker">02 / TWO WAYS TO USE IT</p><h2 id="ways-title">Start simple. <span>Add review only when it helps.</span></h2><p>Both paths use the same document metadata and acceptance record. Scroll is a choice, not the reason to install the package.</p></div>
      <div class="way-grid">
        <a class="way-card simple-way" href="/docs/installation/">
          <div class="way-top"><span>01</span><span>SIMPLE AGREEMENT</span></div>
          <div class="way-preview"><span class="preview-check" aria-hidden="true">✓</span><span>I agree to the <u>Terms</u> and <u>Privacy Policy</u></span></div>
          <h3>Links and a checkbox.</h3><p>Accept immediately, return a timestamped payload, and ask again when declared versions change.</p><span class="way-link">See the quick start <span aria-hidden="true">↗</span></span>
        </a>
        <a class="way-card review-way" href="/docs/review/">
          <div class="way-top"><span>02</span><span>OPTIONAL REVIEW</span></div>
          <div class="review-preview" aria-hidden="true"><div><span>Terms of Service</span><span>×</span></div><div class="review-tabs"><span>Terms</span><span>Privacy</span></div><div class="review-lines"><i></i><i></i><i></i></div><div class="review-progress"><i></i></div></div>
          <h3>A more explicit flow.</h3><p>Show document content and optionally require scroll completion or minimum display time.</p><span class="way-link">Explore optional review <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div></section>

    <section class="build-section home-wrap" aria-labelledby="build-title">
      <div class="build-copy"><p class="section-kicker">03 / YOUR UI, YOUR RULES</p><h2 id="build-title">Own the documents.<br /><span>Keep the flow.</span></h2><p>The developer supplies URLs, versions, and where to save records; review flows can also include document content. agree-first manages matching, state, and the optional review experience. It does not fetch legal text or make compliance claims.</p><ul><li>Headless render prop or optional default styles</li><li>Local storage convenience or your own backend</li><li>Zero runtime dependencies in the library</li></ul><a class="text-link" href="/docs/styling/">Explore styling options <span aria-hidden="true">↗</span></a></div>
      <div class="code-card"><div class="code-top"><span class="code-dots" aria-hidden="true">● ● ●</span><span>AgreementField.tsx</span><span>TSX</span></div><pre><code>{exampleCode}</code></pre><div class="code-bottom"><span>Small API. No required backend or CSS.</span><span aria-hidden="true">↗</span></div></div>
    </section>

    <section class="home-closing"><div class="home-wrap closing-inner"><div><p class="section-kicker">BUILD THE FLOW, NOT THE BOILERPLATE</p><h2>Give every version<br />a clear path to acceptance.</h2><p>Versioned agreement flows for React, with an optional review step when your product needs one.</p></div><a class="home-button home-button-primary" href="/docs/">Read the documentation <span aria-hidden="true">↗</span></a></div></section>
  </div>
</BaseLayout>

<script>
  import { mountDottedGlow } from "../scripts/dottedGlow";

  const hero = document.querySelector<HTMLElement>(".home-hero");
  const glowCanvas = hero?.querySelector<HTMLCanvasElement>(".hero-dots");
  if (hero && glowCanvas) mountDottedGlow(glowCanvas, hero);

  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-command]");
  const copyLabel = copyButton?.querySelector<HTMLElement>("[data-copy-label]");
  let resetCopyLabel: ReturnType<typeof setTimeout> | undefined;

  copyButton?.addEventListener("click", async () => {
    if (!copyLabel) return;

    try {
      await navigator.clipboard.writeText("npm install agree-first");
      copyButton.dataset.state = "copied";
      copyButton.setAttribute("aria-label", "Copied to clipboard");
      copyLabel.textContent = "Copied";
    } catch {
      copyButton.dataset.state = "error";
      copyButton.setAttribute("aria-label", "Copy failed; try again");
      copyLabel.textContent = "Copy failed";
    }

    if (resetCopyLabel) clearTimeout(resetCopyLabel);
    resetCopyLabel = setTimeout(() => {
      copyButton.dataset.state = "";
      copyButton.setAttribute("aria-label", "Copy install command");
      copyLabel.textContent = "Copy";
    }, 2200);
  });
</script>

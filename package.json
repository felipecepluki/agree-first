{
  "name": "agree-first",
  "version": "0.1.0",
  "type": "commonjs",
  "description": "Headless React consent and terms modal that tracks scroll completion and generates timestamped consent payloads",
  "license": "MIT",
  "author": "Felipe Cepluki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecepluki/agree-first.git"
  },
  "homepage": "https://github.com/felipecepluki/agree-first#readme",
  "bugs": {
    "url": "https://github.com/felipecepluki/agree-first/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "terms",
    "consent",
    "gdpr",
    "lgpd",
    "modal",
    "terms-of-service",
    "privacy-policy",
    "headless",
    "agreement",
    "consent-management"
  ],
  "sideEffects": [
    "*.css",
    "dist/styles/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles": {
      "types": "./dist/styles/default.d.ts",
      "default": "./dist/styles/default.css"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "size:report": "node scripts/report-size.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint --pack false",
    "check:package": "attw --pack . --profile node16",
    "prepublishOnly": "npm test && npm run typecheck && npm run build && npm run lint:package && npm run check:package && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "publint": "^0.3.24",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
